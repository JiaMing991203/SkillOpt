# Machine-specific settings for the lean_skillopt cluster workflow.
#
# Copy to research/cluster/site.env (git-ignored) and fill in. deploy.sh
# uploads it to $CLUSTER_SITE_ENV on the cluster, where Slurm jobs read it,
# and every run directory keeps a copy. Non-secret values only; the API key
# goes in $SECRETS_FILE on the cluster.

# ── Access ───────────────────────────────────────────────────────────────────
SSH_HOST=<ssh-alias>                       # e.g. a ~/.ssh/config Host entry

# ── Slurm ────────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=<slurm-account>
GPU_PARTITION=<gpu-partition-with-A40s>
CPU_PARTITION=<cpu-partition>

# ── Storage on the cluster ───────────────────────────────────────────────────
PROJECT_ROOT=<persistent-project-dir>/lean_skillopt
REPO_DIR=$PROJECT_ROOT/SkillOpt               # deployment clone (fetch only, never edit)
SNAPSHOT_ROOT=$PROJECT_ROOT/snapshots         # one detached worktree per deployed commit
RUN_ROOT=$PROJECT_ROOT/runs                   # one directory per Slurm run
ALFWORLD_DATA=$PROJECT_ROOT/alfworld_data     # alfworld-download target
HF_HOME=<huggingface-cache-dir>

# ── Environments (created by setup_env.sbatch; existing envs are never modified)
CONDA_BASE=<conda-install-dir>
CTL_ENV=<conda-envs-dir>/skillopt             # SkillOpt + ALFWorld controller
VLLM_ENV=<conda-envs-dir>/skillopt-vllm       # vLLM server only

# ── Cluster-side config files (outside every repository) ─────────────────────
CLUSTER_SITE_ENV=<cluster-home>/.config/lean_skillopt/site.env
SECRETS_FILE=<cluster-home>/.config/lean_skillopt/secrets.env   # DEEPSEEK_API_KEY=..., chmod 600

# ── Local ────────────────────────────────────────────────────────────────────
LOCAL_RUNS=<local-dir-for-fetched-runs>       # outside the git checkout
