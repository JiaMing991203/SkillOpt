# Experiment-defining settings (tracked): these must be identical across runs
# that are compared, so they live in git, not in the private site.env.
# Sourced by research/cluster/lib.sh inside Slurm jobs.

# ── Target model (frozen) ────────────────────────────────────────────────────
TARGET_MODEL_ID=Qwen/Qwen3.5-4B
TARGET_MODEL_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a  # HF sha seen 2026-10-19
# Must match configs/research/alfworld_qwen35_deepseek.yaml (exported for
# research/preflight_endpoints.py, which reads the qwen_chat env directly).
TARGET_QWEN_CHAT_THINKING_MODE=disabled
TARGET_QWEN_CHAT_TEMPERATURE=0.7
TARGET_QWEN_CHAT_MAX_TOKENS=8000

# ── vLLM server ──────────────────────────────────────────────────────────────
# 0.28.0 includes PR #50999: single-node executors rendezvous via file://
# (FileStore) instead of a TCPStore bound to all interfaces (job 64331018).
# torch 2.13.0 (CUDA 13.0). The 0.25.1 env is kept untouched for reference.
LSO_VLLM_VERSION=0.28.0
LSO_VLLM_MAX_MODEL_LEN=32768
LSO_VLLM_GPU_MEM_UTIL=0.85
# Sampler kernel: vLLM's native PyTorch top-k/top-p instead of FlashInfer,
# whose sampling module JIT-compiles at startup and needs nvcc (job 64329002).
# Passed only to the vLLM process as VLLM_USE_FLASHINFER_SAMPLER, verified
# from vllm.log at startup, and recorded in every manifest. Keep identical
# across all baseline and Lean-guided arms.
LSO_VLLM_USE_FLASHINFER_SAMPLER=0
# Prefix caching: v0.25.1 ran Qwen3.5 (hybrid attention) with it disabled
# (unsupported there); v0.28.0 enables it by default for hybrid models
# (PR #50991). Pinned off for parity: start_vllm passes
# --no-enable-prefix-caching and check_vllm_engine_config verifies the log.
LSO_VLLM_ENABLE_PREFIX_CACHING=0

# ── Python environments ──────────────────────────────────────────────────────
CTL_PYTHON_VERSION=3.11
LSO_VLLM_PYTHON_VERSION=3.12
ALFWORLD_VERSION=0.4.2

# ── Optimizer (hosted) ───────────────────────────────────────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model id for "DeepSeek V4.1 Flash" is resolved from GET /models by
# check_compute.sbatch, then pinned here in a commit.
OPTIMIZER_MODEL=${OPTIMIZER_MODEL:-}
